# Copy to .env and replace the values; quote the multiline private key.
DEPLOY_HOST=maki-math.com
DEPLOY_USER=deploy
DEPLOY_SSH_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
REPLACE_WITH_COMPLETE_PRIVATE_KEY
-----END OPENSSH PRIVATE KEY-----"
DEPLOY_KNOWN_HOSTS="maki-math.com ssh-ed25519 REPLACE_WITH_VERIFIED_HOST_KEY"
